generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  fullname  String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  carts     Cart?
  Payment   Payment[]
  profiles  Profile[]
  courses   courses[]
}

model CourseDetail {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  content   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  course    courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  total     Decimal
  subtotal  Decimal
  discount  Decimal?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
  Payment   Payment?
}

model CartItem {
  id       String  @id @default(uuid())
  cartId   String
  courseId String
  // created_at DateTime @default(now()) @db.Timestamptz(6)
  // updated_at DateTime @db.Timestamptz(6)
  cart     Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course   courses @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
}

model Payment {
  id        String   @id @default(uuid())
  cartId    String   @unique
  userId    String
  amount    Decimal  @db.Decimal(10, 2)
  status    Status   @default(PENDING)
  evidence  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  Cart      Cart     @relation(fields: [cartId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Profile {
  id     String @id @default(uuid())
  userId String
  phone  Int
  image  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id
  content    String
  rating     Int
  courseId   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  courses    courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model courses {
  id             String         @id
  course_name    String
  category       String
  description    String
  thumbnail_url  String
  video_preview  String?
  price          Decimal        @db.Decimal(10, 2)
  discount       Decimal?       @db.Decimal(10, 2)
  tags           String[]
  status         Status         @default(DRAFT)
  average_rating Decimal?       @db.Decimal(3, 2)
  total_students Int            @default(0)
  total_lessons  Int            @default(0)
  total_duration String?
  instructor_id  String
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @db.Timestamptz(6)
  cartItems      CartItem[]
  courseDetails  CourseDetail[]
  Review         Review[]
  User           User           @relation(fields: [instructor_id], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  INSTRUCTOR
}

enum Status {
  DRAFT
  PENDING
  ACTIVE
  CANCELLED
}
