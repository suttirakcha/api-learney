// ==========================================
// 🚀 NEW AI Career Assessment System
// ==========================================

enum AssessmentQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING_SCALE
}

enum CareerAssessmentStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CareerAssessmentQuestion {
  id        String                 @id @default(uuid())
  prompt    String                 @db.Text
  type      AssessmentQuestionType @default(SINGLE_CHOICE)
  category  String // e.g., analytical_thinking, creativity
  order     Int
  active    Boolean                @default(true)
  createdAt DateTime               @default(now()) @db.Timestamptz()
  updatedAt DateTime               @updatedAt @db.Timestamptz()

  options CareerAssessmentOption[]
  answers CareerAssessmentAnswer[]
}

model CareerAssessmentOption {
  id         String @id @default(uuid())
  questionId String
  text       String @db.Text
  weight     Float // น้ำหนักคะแนนสำหรับตัวเลือกนี้ (เช่น 1-5)
  order      Int    @default(0)

  question CareerAssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  CareerAssessmentAnswer[]
}

model CareerAssessmentSession {
  id        String                 @id @default(uuid())
  userId    String? // รองรับ Guest
  status    CareerAssessmentStatus @default(IN_PROGRESS)
  createdAt DateTime               @default(now()) @db.Timestamptz()
  updatedAt DateTime               @updatedAt @db.Timestamptz()

  user    User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers CareerAssessmentAnswer[]
  result  CareerAssessmentResult?
}

model CareerAssessmentAnswer {
  id          String  @id @default(uuid())
  sessionId   String
  questionId  String
  optionId    String?
  ratingValue Int? // กรณีเป็น RATING_SCALE

  session  CareerAssessmentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question CareerAssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   CareerAssessmentOption?  @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model CareerAssessmentResult {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  aiSummary    String   @db.Text
  strengths    String[]
  improvements String[]
  learningPath Json // [{ step: 1, title: '...', desc: '...' }]
  createdAt    DateTime @default(now()) @db.Timestamptz()

  session            CareerAssessmentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  categoryScores     CareerCategoryScore[]
  recommendedCareers RecommendedCareerMapping[]
  recommendedCourses RecommendedCourseMapping[]
}

model CareerCategoryScore {
  id       String @id @default(uuid())
  resultId String
  category String
  score    Float

  result CareerAssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
}

model CareerMapping {
  id             String @id @default(uuid())
  careerId       String
  category       String // ต้องตรงกับ category ของ Question (เช่น analytical_thinking)
  requiredWeight Float // ค่าน้ำหนักความสำคัญที่อาชีพนี้ต้องการ (เช่น 0.0 - 1.0)

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([careerId, category])
}

model RecommendedCareerMapping {
  id              String @id @default(uuid())
  resultId        String
  careerId        String
  matchPercentage Float // เปอร์เซ็นต์ความเข้ากันได้
  rank            Int

  result CareerAssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  career Career                 @relation(fields: [careerId], references: [id], onDelete: Cascade)
}

model RecommendedCourseMapping {
  id       String @id @default(uuid())
  resultId String
  courseId String
  reason   String @db.Text

  result CareerAssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  course Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ==========================================
// 🤖 AI Chatbot Assistant System
// ==========================================

enum ChatSenderType {
  USER
  BOT
  SYSTEM
}

enum ChatMessageType {
  TEXT
  COURSE_CARD
  QUICK_REPLY
  ACTION_LINK
}

enum ChatSessionStatus {
  ACTIVE
  CLOSED
}

model ChatSession {
  id            String            @id @default(uuid())
  userId        String? // รองรับ Member
  guestToken    String? // รองรับ Guest
  title         String?           @db.VarChar(255)
  status        ChatSessionStatus @default(ACTIVE)
  startedAt     DateTime          @default(now()) @db.Timestamptz()
  lastMessageAt DateTime          @default(now()) @db.Timestamptz()
  createdAt     DateTime          @default(now()) @db.Timestamptz()
  updatedAt     DateTime          @updatedAt @db.Timestamptz()

  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]
  intentLogs ChatbotIntentLog[]
}

model ChatMessage {
  id          String          @id @default(uuid())
  sessionId   String
  senderType  ChatSenderType  @default(USER)
  message     String          @db.Text
  messageType ChatMessageType @default(TEXT)
  metadata    Json? // เก็บข้อมูลเช่น courseId, ลิงก์, หรือ options
  createdAt   DateTime        @default(now()) @db.Timestamptz()

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model FAQ {
  id          String   @id @default(uuid())
  question    String   @db.Text
  answer      String   @db.Text
  keywords    String[] // คีย์เวิร์ดสำหรับให้ Bot ค้นหา
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()
}

model ChatbotSetting {
  id                    String   @id @default(uuid())
  isEnabled             Boolean  @default(true)
  welcomeMessage        String   @db.Text
  fallbackMessage       String   @db.Text
  offlineMessage        String   @db.Text
  primaryColor          String   @default("#bda9ff")
  allowGuestChat        Boolean  @default(true)
  saveHistory           Boolean  @default(true)
  maxMessagesPerSession Int      @default(100)
  createdAt             DateTime @default(now()) @db.Timestamptz()
  updatedAt             DateTime @updatedAt @db.Timestamptz()
}

model SuggestedQuestion {
  id        String   @id @default(uuid())
  question  String   @db.VarChar(255)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz()
}

model ChatbotKnowledge {
  id         String   @id @default(uuid())
  title      String   @db.VarChar(255)
  content    String   @db.Text
  sourceType String // เช่น MANUAL, SCRAPED, UPLOADED
  tags       String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz()
  updatedAt  DateTime @updatedAt @db.Timestamptz()
}

model ChatbotIntentLog {
  id             String   @id @default(uuid())
  sessionId      String?
  userMessage    String   @db.Text
  detectedIntent String   @db.VarChar(100)
  confidence     Float    @default(1.0)
  matchedSource  String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @db.Timestamptz()

  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
}

// ==========================================
// 🧭 NEW Career Discovery Assessment System
// ==========================================

model AssessmentStage {
  id            String  @id @default(cuid())
  slug          String  @unique
  titleTh       String
  titleEn       String
  descriptionTh String?
  ageMin        Int
  ageMax        Int
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  questions CareerDiscoveryQuestion[]
  sessions  AssessmentSession[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()
}

model CareerDiscoveryQuestion {
  id      String          @id @default(cuid())
  stageId String
  stage   AssessmentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  questionText   String  @db.Text
  helperText     String? @db.Text
  type           String  @default("LIKERT_5")
  traitCode      String
  traitDimension String
  scoreWeight    Float   @default(1)
  reverseScore   Boolean @default(false)
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  choices AssessmentChoice[]

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

model AssessmentChoice {
  id         String                  @id @default(cuid())
  questionId String
  question   CareerDiscoveryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label     String
  value     Int
  sortOrder Int    @default(0)
}

model AssessmentSession {
  id      String          @id @default(cuid())
  userId  String
  stageId String
  stage   AssessmentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user    User            @relation("UserAssessmentSessions", fields: [userId], references: [id], onDelete: Cascade)

  status      String    @default("IN_PROGRESS")
  version     Int       @default(1)
  startedAt   DateTime  @default(now()) @db.Timestamptz()
  completedAt DateTime? @db.Timestamptz()

  answers AssessmentAnswer[]
  result  AssessmentResult?
}

model AssessmentAnswer {
  id          String @id @default(cuid())
  sessionId   String
  questionId  String
  choiceValue Int

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model AssessmentResult {
  id        String            @id @default(cuid())
  sessionId String            @unique
  session   AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  topTraitsJson     Json
  growthAreasJson   Json
  careerMatchesJson Json
  aiSummary         String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz()
}

model HomeShowcase {
  id                String   @id @default(cuid())
  title             String
  subtitle          String?
  badge             String?
  description       String?
  desktopImageUrl   String
  mobileImageUrl    String?
  primaryText       String?
  primaryHref       String?
  secondaryText     String?
  secondaryHref     String?
  overlayOpacity    Float    @default(0.18)
  textAlign         String   @default("left")
  mediaPosition     String   @default("right")
  enableAnimation   Boolean  @default(true)
  enableFloating    Boolean  @default(true)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  startsAt          DateTime? @db.Timestamptz()
  endsAt            DateTime? @db.Timestamptz()
  createdAt         DateTime  @default(now()) @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @db.Timestamptz()

  @@index([isActive, startsAt, endsAt, sortOrder])
}
