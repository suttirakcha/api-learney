model CourseCertificateRule {
  id                   String   @id @default(uuid())
  courseId             String   @unique
  requirePostTest      Boolean  @default(true)
  minimumPostTestScore Float? // เช่น 80% ถึงจะผ่าน
  createdAt            DateTime @default(now()) @db.Timestamptz()
  updatedAt            DateTime @updatedAt @db.Timestamptz()
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseTest {
  id           String           @id @default(uuid())
  courseId     String
  title        String
  description  String?          @db.Text
  type         CourseTestType
  status       CourseTestStatus @default(DRAFT)
  timeLimit    Int? // เวลาในการทำสอบ (นาที)
  passingScore Float? // คะแนนที่ถือว่าผ่าน
  createdAt    DateTime         @default(now()) @db.Timestamptz()
  updatedAt    DateTime         @updatedAt @db.Timestamptz()

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections TestSection[]
  attempts TestAttempt[]

  @@unique([courseId, type]) // 1 คอร์ส มี Pre 1 อัน และ Post 1 อัน ที่ใช้งานได้
}

model TestSection {
  id          String  @id @default(uuid())
  testId      String
  title       String
  description String?
  order       Int     @default(0)
  dimension   String? // หมวดหมู่ทักษะหลักของ Section นี้ (เช่น Logic, Design)

  test      CourseTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions TestQuestion[]
}

model TestQuestion {
  id          String           @id @default(uuid())
  sectionId   String
  prompt      String           @db.Text
  type        TestQuestionType @default(MULTIPLE_CHOICE)
  difficulty  DifficultyLevel  @default(MEDIUM)
  scoreWeight Float            @default(1.0)
  order       Int              @default(0)
  aiRubric    String?          @db.Text // เกณฑ์ให้ AI ตรวจสำหรับอัตนัย

  section TestSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  choices TestChoice[]
  answers TestAnswer[]
}

model TestChoice {
  id          String  @id @default(uuid())
  questionId  String
  text        String  @db.Text
  isCorrect   Boolean @default(false)
  order       Int     @default(0)
  explanation String? @db.Text // คำอธิบายเฉลย

  question TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestAttempt {
  id          String            @id @default(uuid())
  testId      String
  userId      String
  status      TestAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now()) @db.Timestamptz()
  submittedAt DateTime?         @db.Timestamptz()

  learnerSnapshot Json? // เก็บ Profile/เป้าหมายผู้เรียน ณ เวลานั้น
  totalScore      Float?
  maxScore        Float?
  normalizedScore Float? // คิดเป็นเปอร์เซ็นต์

  test       CourseTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    TestAnswer[]
  evaluation TestEvaluation?
}

model TestAnswer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedChoiceId String?
  textAnswer       String?  @db.Text // สำหรับอัตนัย
  isCorrect        Boolean?
  scoreEarned      Float?
  aiFeedback       String?  @db.Text // Feedback รายข้อจาก AI

  attempt  TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestEvaluation {
  id              String   @id @default(uuid())
  attemptId       String   @unique
  learnerLevel    String // Beginner, Intermediate, Advanced
  aiSummary       String   @db.Text
  strengths       String[]
  weaknesses      String[]
  recommendations Json // รายการคอร์ส/บทเรียนที่แนะนำ
  dimensionScores Json // Record<string, {score: number, max: number}>
  evaluatedAt     DateTime @default(now()) @db.Timestamptz()

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

