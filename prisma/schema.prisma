generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  INSTRUCTOR
}

enum Status {
  DRAFT
  PENDING
  ACTIVE
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  fullname  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  carts    Cart[]
  profiles Profile[]
  courses  Course[]
  payment  Payment[]
}

model Course {
  id           String   @id @default(uuid())
  courseName   String   @map("course_name")
  category     String
  description  String   @db.Text
  thumbnail    String   @map("thumbnail_url")
  videoPreview String?  @map("video_preview")
  price        Decimal  @db.Decimal(10, 2)
  discount     Decimal? @db.Decimal(10, 2)
  tags         String[]
  status       Status   @default(DRAFT)

  averageRating Decimal? @map("average_rating") @db.Decimal(3, 2)
  totalStudents Int      @default(0) @map("total_students")
  totalLessons  Int      @default(0) @map("total_lessons")
  totalDuration String?  @map("total_duration")

  instructorId String   @map("instructor_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  instructor    User           @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  courseDetails CourseDetail[]
  cartItems     CartItem[]
  reviews       Review[]
}

model CourseDetail {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  content   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  coursesId String?
}

model Cart {
  id        String   @id @default(uuid())
  userId    String
  total     Decimal
  subtotal  Decimal
  discount  Decimal?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
  payment   Payment?
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  courseId String
  // created_at DateTime @default(now()) @db.Timestamptz(6)
  // updated_at DateTime @db.Timestamptz(6)
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  coursesId String?

  @@unique([cartId, courseId])
}

model Payment {
  id        String   @id @default(uuid())
  cartId    String   @unique
  userId    String
  amount    Decimal  @db.Decimal(10, 2)
  status    Status   @default(PENDING)
  evidence  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  cart Cart @relation(fields: [cartId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Profile {
  id     String @id @default(uuid())
  userId String
  phone  Int
  image  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id
  content    String
  rating     Int
  courseId   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  coursesId String?
}
