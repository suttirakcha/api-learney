generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  INSTRUCTOR
}

enum Permission {
  MANAGE_USERS
  MANAGE_INSTRUCTORS
  APPROVE_INSTRUCTORS
  MANAGE_COURSES
  APPROVE_COURSES
  MANAGE_PROMOTIONS
  MANAGE_THEMES
  REVIEW_CONTENT
  APPROVE_AI_DRAFTS
  MANAGE_SETTINGS
  VIEW_ADMIN_ANALYTICS
  VIEW_INSTRUCTOR_ANALYTICS
  MANAGE_OWN_COURSES
  MANAGE_OWN_PROFILE
  VIEW_OWN_STUDENTS
  MANAGE_OWN_QUIZZES
}

enum Status {
  DRAFT
  PENDING
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LessonType {
  VIDEO
  DOCS
}

enum LocaleCode {
  TH
  EN
}

enum CourseWorkflowStatus {
  DRAFT
  EDITING
  SUBMITTED
  PENDING_APPROVAL
  NEEDS_REVISION
  AI_GENERATED
  ADMIN_REVIEW
  EDITED
  APPROVED
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum CourseSourceType {
  MANUAL
  AI_GENERATED
  EXPANDED
}

enum ModerationStatus {
  VISIBLE
  FLAGGED
  HIDDEN
  DELETED
}

enum DiscussionType {
  DISCUSSION
  QUESTION
  USE_CASE
  ANNOUNCEMENT
}

enum PromotionType {
  FLASH_SALE
  SEASONAL_SALE
  PROMO_CODE
  FEATURED_CAMPAIGN
  PERCENTAGE_DISCOUNT
  FIXED_AMOUNT_DISCOUNT
  COUPON_CODE
  BUY_ONE_GET_ONE
  FIRST_USER_DISCOUNT
  CATEGORY_PROMOTION
  COURSE_PROMOTION
  INSTRUCTOR_PROMOTION
  SEASONAL_PROMOTION
}

enum SeasonalThemeKey {
  SONGKRAN
  NEW_YEAR
  VALENTINE
  PRIDE
  HALLOWEEN
  LOY_KRATHONG
  CHRISTMAS
  BACK_TO_SCHOOL
  EXAM_PREP
  AI_TECH
}

enum InstructorApplicationStatus {
  PENDING
  APPROVED
  NEEDS_CHANGES
  REJECTED
}

enum CourseReviewStatus {
  SUBMITTED
  PENDING_APPROVAL
  NEEDS_REVISION
  APPROVED
  REJECTED
}

enum ReviewQueueContentType {
  COURSE_DESCRIPTION
  LESSON_CONTENT
  THUMBNAIL
  PREVIEW_VIDEO
  COMMENT
  REVIEW
  COMMUNITY_POST
  ATTACHMENT
  AI_DRAFT
}

enum ReviewQueueStatus {
  PENDING
  APPROVED
  HIDDEN
  REJECTED
  NEEDS_CHANGES
  DELETED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SeasonalThemeActivationMode {
  MANUAL
  AUTOMATIC
}

enum PreviewVideoProvider {
  YOUTUBE
  VIMEO
  FILE_URL
  UPLOAD
}

enum SkillExercisePlacement {
  BEFORE_LEARNING
  AFTER_LEARNING
  OPTIONAL
}

enum SkillExerciseStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SkillQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  MATCHING
  ORDERING
}

enum SkillAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum NotificationAudience {
  ADMIN
  INSTRUCTOR
  STUDENT
  SYSTEM
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum PlatformSettingSection {
  GENERAL
  SEO
  LOCALIZATION
  PAYMENT
  COURSE
  REVIEW
  COMMUNITY
  NOTIFICATION
  AI
  THEME
  PROMOTION
  HOMEPAGE
  LEGAL
}

enum PromotionScopeType {
  GLOBAL
  COURSE
  CATEGORY
  INSTRUCTOR
}

enum AssessmentKind {
  PRE_TEST
  POST_TEST
  DISCOVERY
}

enum AttemptSourceType {
  DISCOVERY
  COURSE_ASSESSMENT
}

enum AiJobType {
  COURSE_BLUEPRINT
  COURSE_EXPANSION
  LESSON_BUNDLE
  VIDEO_BUNDLE
  CASE_STUDY_BUNDLE
  QUIZ_BUNDLE
  COURSE_REFRESH
  COURSE_SUGGESTION
}

enum AiDraftStatus {
  DRAFT
  AI_GENERATED
  ADMIN_REVIEW
  EDITED
  APPROVED
  PUBLISHED
}

enum CourseTestType {
  PRE_TEST
  POST_TEST
}

enum CourseTestStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TestQuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  SCENARIO
  ORDERING
  MATCHING
  SELF_RATING
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum TestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  CANCELLED
}

enum RecommendationType {
  LESSON
  COURSE
  SKILL_PATH
  CAREER_HINT
}

model User {
  id                 String       @id @default(uuid())
  fullname           String
  email              String       @unique
  password           String
  role               Role         @default(USER)
  roles              Role[]       @default([USER])
  permissions        Permission[] @default([])
  phone              String?
  image              String?
  localePreference   LocaleCode?  @default(TH)
  themePreference    String?
  preferredWorkspace Role?        @default(USER)
  isActive           Boolean      @default(true)
  isSuspended        Boolean      @default(false)
  lastLoginAt        DateTime?    @db.Timestamptz()
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  carts                          Cart[]
  courses                        Course[]                  @relation("InstructorCourses")
  approvedCourses                Course[]                  @relation("CourseApprovedBy")
  payments                       Payment[]
  enrolledCourses                EnrolledCourse[]
  wishlist                       Wishlist?
  reviews                        Review[]
  communityThreads               CommunityThread[]
  communityReplies               CommunityReply[]
  communityReports               CommunityReport[]
  skillTestAttempts              SkillTestAttempt[]
  aiJobs                         AiGenerationJob[]         @relation("AiJobsCreator")
  aiDraftsEdited                 AiDraft[]                 @relation("AiDraftEditor")
  aiDraftApprovals               AiDraft[]                 @relation("AiDraftApprover")
  aiDraftApprovalLogs            AiDraftApproval[]
  instructorProfile              InstructorProfile?
  instructorApplications         InstructorApplication[]   @relation("InstructorApplicationApplicant")
  reviewedInstructorApplications InstructorApplication[]   @relation("InstructorApplicationReviewer")
  testAttempts                   TestAttempt[]
  careerSessions                 CareerAssessmentSession[]
  courseReviewRequests           PendingCourseReview[]     @relation("CourseReviewInstructor")
  courseReviewApprovals          PendingCourseReview[]     @relation("CourseReviewAdmin")
  submittedContentReviews        ContentReviewQueue[]      @relation("ContentSubmittedBy")
  reviewedContentReviews         ContentReviewQueue[]      @relation("ContentReviewedBy")
  updatedPlatformSettings        PlatformSetting[]         @relation("PlatformSettingUpdatedBy")
  previewVideosCreated           CoursePreviewVideo[]      @relation("PreviewVideoOwner")
  skillExercisesOwned            SkillExercise[]           @relation("SkillExerciseOwner")
  skillExerciseAttempts          SkillExerciseAttempt[]
  adminAuditLogs                 AdminAuditLog[]           @relation("AdminAuditActor")
  notifications                  NotificationLog[]         @relation("NotificationRecipient")
  notificationActions            NotificationLog[]         @relation("NotificationActor")
  promotionUsages                PromotionUsage[]
  chatSessions                   ChatSession[]
  communityLikes                 CommunityLike[]
  communityBookmarks             CommunityBookmark[]
  assessmentSessions             AssessmentSession[]       @relation("UserAssessmentSessions")
}

model InstructorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  displayName     String
  bio             Json?
  image           String?
  headline        Json?
  visible         Boolean  @default(true)
  specialties     String[]
  expertiseAreas  String[]
  experienceYears Int?
  portfolioUrl    String?
  payoutAccount   String?
  contactEmail    String?
  createdAt       DateTime @default(now()) @db.Timestamptz()
  updatedAt       DateTime @updatedAt @db.Timestamptz()

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayedCourses Course[]                @relation("DisplayInstructor")
  applications     InstructorApplication[]
}

model Category {
  id          String   @id @default(uuid())
  key         String   @unique
  slug        String   @unique
  name        Json
  legacyName  String?  @unique
  icon        String?
  color       String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  description Json?
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()

  courses Course[]
}

model Course {
  id                   String               @id @default(uuid())
  slug                 String?              @unique
  courseName           String               @map("course_name")
  title                Json?
  shortDescription     Json?
  description          String               @db.Text
  localizedDescription Json?
  category             String
  categoryId           String?
  coverImage           String?              @map("cover_image")
  thumbnail            String               @map("thumbnail_url")
  videoPreview         String?              @map("video_preview")
  previewVideoUrl      String?
  previewThumbnail     String?
  price                Decimal              @db.Decimal(10, 2)
  discount             Decimal?             @db.Decimal(10, 2)
  discountPrice        Decimal?             @db.Decimal(10, 2)
  level                String?
  badge                String?
  tags                 String[]
  status               Status               @default(DRAFT)
  workflowStatus       CourseWorkflowStatus @default(DRAFT)
  sourceType           CourseSourceType     @default(MANUAL)
  currentVersion       Int                  @default(1)
  isPopular            Boolean              @default(false)
  isFeatured           Boolean              @default(false)
  isPublished          Boolean              @default(false)
  closedEnrollment     Boolean              @default(false)
  hiddenFromCatalog    Boolean              @default(false)
  certificateEnabled   Boolean              @default(false)
  publishedAt          DateTime?            @db.Timestamptz()
  approvalRequestedAt  DateTime?            @db.Timestamptz()
  lastSubmittedAt      DateTime?            @db.Timestamptz()
  approvedAt           DateTime?            @db.Timestamptz()
  approvedById         String?
  rejectionReason      String?              @db.Text
  revisionNotes        String?              @db.Text
  learnerCount         Int                  @default(0)
  reviewCount          Int                  @default(0)
  averageRating        Decimal?             @map("average_rating") @db.Decimal(3, 2)
  duration             String?
  language             LocaleCode?
  instructorId         String               @map("instructor_id")
  displayInstructorId  String?
  targetAudience       String[]
  seoTitle             String?
  seoDescription       String?              @db.Text
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  willLearnMessages    String[]
  requirements         String[]

  instructor            User                       @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  approvedBy            User?                      @relation("CourseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  displayInstructor     InstructorProfile?         @relation("DisplayInstructor", fields: [displayInstructorId], references: [id], onDelete: SetNull)
  categoryRecord        Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  courseDetails         CourseDetail[]
  cartItems             CartItem[]
  wishlistItems         WishlistItem[]
  reviews               Review[]
  enrolledCourses       EnrolledCourse[]
  communityThreads      CommunityThread[]
  promotions            PromotionCourse[]
  featuredPlacement     HomepageFeaturedCourse?
  courseAssessments     CourseAssessment[]
  skillTestAttempts     SkillTestAttempt[]
  modules               CourseModuleEntity[]
  lessons               CourseLesson[]
  aiJobs                AiGenerationJob[]
  aiDrafts              AiDraft[]
  courseTests           CourseTest[]
  certificateRules      CourseCertificateRule?
  recommendedIn         RecommendedCourseMapping[]
  previewVideos         CoursePreviewVideo[]
  pendingReviews        PendingCourseReview[]
  contentReviews        ContentReviewQueue[]
  skillExercises        SkillExercise[]
  promotionUsages       PromotionUsage[]
  recommendationCourses RecommendationCourse[]
}

model CourseDetail {
  id        String     @id @default(uuid())
  courseId  String
  title     String
  type      LessonType
  video     String?
  docs      String?    @db.Text
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseModuleEntity {
  id        String   @id @default(uuid())
  courseId  String
  title     Json?
  summary   Json?
  order     Int
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]
}

model CourseLesson {
  id               String   @id @default(uuid())
  courseId         String
  moduleId         String?
  title            Json?
  summary          Json?
  draftContent     Json?
  instructorScript String?  @db.Text
  slideOutline     Json?
  worksheet        Json?
  keyTakeaways     Json?
  examples         Json?
  durationMinutes  Int?
  order            Int
  published        Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz()
  updatedAt        DateTime @updatedAt @db.Timestamptz()

  course Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module CourseModuleEntity? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  assets LessonAsset[]
}

model LessonAsset {
  id             String   @id @default(uuid())
  courseLessonId String
  kind           String
  title          Json?
  content        Json?
  url            String?
  order          Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  courseLesson CourseLesson @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
}

model EnrolledCourse {
  id       String @id @default(uuid())
  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId], name: "enrollmentIdentifier")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  courseId   String
  createdAt  DateTime @default(now()) @db.Timestamptz()

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, courseId], name: "wishlistCourseIdentifier")
}

model Cart {
  id                   String   @id @default(uuid())
  userId               String   @unique
  appliedPromotionId   String?
  appliedPromotionCode String?
  total                Decimal
  subtotal             Decimal
  discount             Decimal?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user             User       @relation(fields: [userId], references: [id])
  appliedPromotion Promotion? @relation(fields: [appliedPromotionId], references: [id], onDelete: SetNull)
  cartItems        CartItem[]
  payment          Payment?
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  courseId String

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId], name: "cartItemIdentifier")
}

model Payment {
  id        String        @id @default(uuid())
  cartId    String        @unique
  userId    String
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  evidence  String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  cart Cart @relation(fields: [cartId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Review {
  id               String           @id @default(uuid())
  content          String
  rating           Int
  courseId         String
  userId           String?
  visible          Boolean          @default(true)
  pinned           Boolean          @default(false)
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CommunityThread {
  id               String           @id @default(uuid())
  slug             String           @unique @default(cuid())
  courseId         String?
  userId           String
  title            Json?
  content          Json
  type             DiscussionType   @default(DISCUSSION)
  pinned           Boolean          @default(false)
  visible          Boolean          @default(true)
  isResolved       Boolean          @default(false)
  moderationStatus ModerationStatus @default(VISIBLE)
  viewCount        Int              @default(0)
  likeCount        Int              @default(0)
  bookmarkCount    Int              @default(0)
  commentCount     Int              @default(0)
  reportCount      Int              @default(0)
  createdAt        DateTime         @default(now()) @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @db.Timestamptz()

  course    Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   CommunityReply[]
  reports   CommunityReport[]
  likes     CommunityLike[]
  bookmarks CommunityBookmark[]
  tags      CommunityTag[]      @relation("ThreadTags")
}

model CommunityReply {
  id               String           @id @default(uuid())
  threadId         String
  userId           String
  parentId         String?
  content          Json
  likeCount        Int              @default(0)
  isEdited         Boolean          @default(false)
  visible          Boolean          @default(true)
  moderationStatus ModerationStatus @default(VISIBLE)
  reportCount      Int              @default(0)
  createdAt        DateTime         @default(now()) @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @db.Timestamptz()

  thread   CommunityThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   CommunityReply?   @relation("NestedReplies", fields: [parentId], references: [id], onDelete: SetNull)
  children CommunityReply[]  @relation("NestedReplies")
  reports  CommunityReport[]
  likes    CommunityLike[]
}

model CommunityReport {
  id        String   @id @default(uuid())
  threadId  String?
  replyId   String?
  userId    String
  reason    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  thread CommunityThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply  CommunityReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityLike {
  id        String   @id @default(uuid())
  userId    String
  threadId  String?
  replyId   String?
  createdAt DateTime @default(now()) @db.Timestamptz()

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread CommunityThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply  CommunityReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, replyId])
}

model CommunityBookmark {
  id        String   @id @default(uuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now()) @db.Timestamptz()

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
}

model CommunityTag {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz()

  threads CommunityThread[] @relation("ThreadTags")
}

model Promotion {
  id             String             @id @default(uuid())
  slug           String             @unique
  title          Json
  description    Json?
  type           PromotionType
  discount       Int?
  banner         String?
  promoCode      String?
  code           String?            @unique
  discountAmount Decimal?           @db.Decimal(10, 2)
  minimumSpend   Decimal?           @db.Decimal(10, 2)
  usageLimit     Int?
  perUserLimit   Int?
  priority       Int                @default(0)
  stackable      Boolean            @default(false)
  scope          PromotionScopeType @default(GLOBAL)
  categoryKeys   String[]
  instructorIds  String[]
  usageCount     Int                @default(0)
  startDate      DateTime           @db.Timestamptz()
  endDate        DateTime           @db.Timestamptz()
  active         Boolean            @default(false)
  themeKey       SeasonalThemeKey?
  createdAt      DateTime           @default(now()) @db.Timestamptz()
  updatedAt      DateTime           @updatedAt @db.Timestamptz()

  carts   Cart[]
  courses PromotionCourse[]
  usages  PromotionUsage[]
}

model PromotionCourse {
  id          String @id @default(uuid())
  promotionId String
  courseId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([promotionId, courseId], name: "promotionCourseIdentifier")
}

model SeasonalTheme {
  id                String                      @id @default(uuid())
  key               SeasonalThemeKey            @unique
  slug              String?                     @unique
  name              Json
  active            Boolean                     @default(false)
  previewMode       Boolean                     @default(false)
  assets            Json?
  activationMode    SeasonalThemeActivationMode @default(MANUAL)
  startDate         DateTime?                   @db.Timestamptz()
  endDate           DateTime?                   @db.Timestamptz()
  bannerUrl         String?
  backgroundUrl     String?
  iconUrl           String?
  primaryColor      String?
  secondaryColor    String?
  typographyConfig  Json?
  buttonStyleConfig Json?
  cardStyleConfig   Json?
  decorationConfig  Json?
  pageTargets       String[]
  lightConfig       Json?
  darkConfig        Json?
  createdAt         DateTime                    @default(now()) @db.Timestamptz()
  updatedAt         DateTime                    @updatedAt @db.Timestamptz()
}

model HomepageFeaturedCourse {
  id        String   @id @default(uuid())
  courseId  String   @unique
  rank      Int
  badge     String?
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Career {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           Json
  summary        Json?
  image          String?
  salaryRange    String?
  requiredSkills String[]
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  rules         CareerRule[]
  recommendedIn RecommendedCareerMapping[]
  mappings      CareerMapping[]
}

model CareerRule {
  id                   String   @id @default(uuid())
  careerId             String
  ageGroup             String?
  skillCategory        String
  threshold            Int
  weight               Int      @default(1)
  recommendedCourseIds String[]
  createdAt            DateTime @default(now()) @db.Timestamptz()
  updatedAt            DateTime @updatedAt @db.Timestamptz()

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
}

model SkillTest {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     Json
  intro     Json?
  ageGroup  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

