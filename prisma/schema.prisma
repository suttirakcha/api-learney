generator client {
  provider     = "prisma-client-js"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  INSTRUCTOR
}

enum Status {
  DRAFT
  PENDING
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        String   @id @default(uuid())
  fullname  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  phone     String?
  image     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  courses  Course[]
  payments Payment[]
  cart     Cart?
}

model Course {
  id           String  @id @default(uuid())
  courseName   String  @map("course_name")
  category     String
  description  String  @db.Text
  thumbnail    String  @map("thumbnail_url")
  videoPreview String? @map("video_preview")

  price    Decimal  @db.Decimal(10, 2)
  discount Decimal? @db.Decimal(10, 2)
  tags     String[]
  status   Status   @default(DRAFT)

  averageRating Decimal? @map("average_rating") @db.Decimal(3, 2)
  totalStudents Int      @default(0) @map("total_students")
  totalLessons  Int      @default(0) @map("total_lessons")
  totalDuration String?  @map("total_duration")

  instructorId String @map("instructor_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  instructor User @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  courseDetails CourseDetail[]
  cartItems     CartItem[]
  reviews       Review[]
}

model CourseDetail {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  content   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  total     Decimal
  subtotal  Decimal
  discount  Decimal?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
  payment   Payment?
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  courseId String

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId], name: "cartItemIdentifier")
}

model Payment {
  id            String  @id @default(uuid())
  cartId        String  @unique
  userId        String
  amount        Decimal @db.Decimal(10, 2)
  status        Status  @default(PENDING)
  evidence      String?
  transactionId String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  cart Cart @relation(fields: [cartId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  content   String
  rating    Int
  courseId  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
